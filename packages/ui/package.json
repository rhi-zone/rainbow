{
  "name": "@rhi-zone/rainbow-ui",
  "version": "0.2.0-alpha.7",
  "description": "Type-safe DOM factories and algebraic widget combinators for rainbow",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types":  "./dist/index.d.ts"
    },
    "./html": {
      "import": "./dist/html.js",
      "types":  "./dist/html.d.ts"
    },
    "./widget": {
      "import": "./dist/widget.js",
      "types":  "./dist/widget.d.ts"
    },
    "./elements": {
      "import": "./dist/elements.js",
      "types":  "./dist/elements.d.ts"
    },
    "./form-state": {
      "import": "./dist/form-state.js",
      "types":  "./dist/form-state.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev":       "vite build --watch",
    "build":     "vite build && tsgo --emitDeclarationOnly",
    "typecheck": "tsgo --noEmit",
    "test":      "vitest run"
  },
  "dependencies": {
    "@rhi-zone/rainbow": "0.2.0-alpha.0"
  },
  "devDependencies": {
    "happy-dom": "^16.0.0",
    "vite":      "^6.0.0",
    "vitest":    "^2.0.0"
  }
}
